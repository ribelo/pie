#!/usr/bin/env bash
# pcapslint-t4bn: require fresh compiler-backed capability evidence.
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

# Prefer the explicit Nix output, then the findlib prefix, then PATH.
installed=""
if lib_dir="$(ocamlfind query ox_lint 2>/dev/null)"; then
  installed="$lib_dir/../../bin/ox-lint"
fi
engine=""
for candidate in "${OX_LINT:-}" "$installed" "$(command -v ox-lint 2>/dev/null || true)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    engine="$candidate"
    break
  fi
done
if [ -z "$engine" ]; then
  echo "caps-gate: ox-lint not found; install ox_lint or set OX_LINT to its executable" >&2
  exit 2
fi

# Inventory queries rebuild volatile generated sources. Keep this validation
# build's timestamp stable across those queries and compiler rebuilds.
export PIE_BUILD_IDENTITY_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# @check also produces executable modules' fresh typed evidence.
dune build @install @check

# No exemptions: generators receive narrow authority from their process entry.
exec "$engine" --caps-gate --require-typed "$@"
